        def test_semantic_layout_separates_clusters(self):
            # two clusters in 4D: within-cluster distances < between-cluster distances
            vecs = {"a1": [1, 0.9, 0, 0], "a2": [0.9, 1, 0, 0],
                    "b1": [0, 0, 1, 0.9], "b2": [0, 0, 0.9, 1]}
            pos = semantic_layout(vecs)
            self.assertEqual(set(pos), set(vecs))
            import math
            d = lambda p, q: math.dist(pos[p], pos[q])
            self.assertLess(d("a1", "a2"), d("a1", "b1"))
            self.assertLess(d("b1", "b2"), d("b2", "a2"))
            self.assertEqual(pos, semantic_layout(vecs))   # deterministic
            self.assertTrue(all(abs(v) <= 1 for p in pos.values() for v in p))

