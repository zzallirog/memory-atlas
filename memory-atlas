        def test_i18n_dict_covers_static_markup(self):
            # drift-guard: every Cyrillic string in the static markup
            # (data-hint/title/placeholder + text nodes) must have an EN translation,
            # otherwise EN mode shows an RU hole. New markup string = new pair in i18nEN.
            tpl_path = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                    "memory-atlas.template.html")
            with open(tpl_path, encoding="utf-8") as f:
                tpl = f.read()
            m = re.search(r'<script type="application/json" id="i18nEN">(.*?)</script>', tpl, re.S)
            self.assertIsNotNone(m, "i18nEN dict block missing")
            en = json.loads(m.group(1).replace("<\\/", "</"))
            cyr = re.compile(r"[А-Яа-яЁё]")
            markup = tpl[:tpl.index('<script type="application/json" id="i18nEN">')]
            markup = re.sub(r"<style>.*?</style>", "", markup, flags=re.S)
            norm = lambda s: re.sub(r"\s+", " ", s.strip())  # the client-side walker normalizes the same way
            missing = set()
            for attr, val in re.findall(r'(data-hint|title|placeholder)="([^"]*)"', markup):
                if cyr.search(val) and norm(val) not in en:
                    missing.add(norm(val))
            for txt in re.findall(r">([^<>]+)<", markup, re.S):
                if cyr.search(txt) and norm(txt) and norm(txt) not in en:
                    missing.add(norm(txt))
            self.assertFalse(missing, f"untranslated static markup: {sorted(missing)[:10]}")

