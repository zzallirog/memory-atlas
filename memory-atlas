VERSION = "2.18.0"  # click-tested pass: HUD foot out of the scrollport, search softened, dice honest
def _data_home():
    # atlas working folder (out/caches): env → legacy path, if it already exists
    # (backward compat for old installs) → XDG cache. No hardcoded host/user names.
    if os.environ.get("ATLAS_HOME"):
        return os.path.expanduser(os.environ["ATLAS_HOME"])
    legacy = os.path.expanduser("~/.cache/memory-atlas")
    if os.path.isdir(legacy):
        return legacy
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA") or os.path.expanduser("~\\AppData\\Local")
        return os.path.join(base, "memory-atlas")
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "memory-atlas")


DATA_HOME = _data_home()


def _resolve_default_src():
    # G1-generic: ATLAS_SRC → any ~/.claude/projects/*/memory with .md files,
    # most populated first (fixes the W5 bug: an empty host-twin gave 0 nodes).
    # Nothing found → None, main() will ask for explicit --src.
    if os.environ.get("ATLAS_SRC"):
        return os.path.expanduser(os.environ["ATLAS_SRC"])
    scored = []
    for c in glob.glob(os.path.expanduser("~/.claude/projects/*/memory")):
        try:
            n = sum(1 for f in os.listdir(c) if f.endswith(".md"))
        except OSError:
            continue
        if n:
            scored.append((n, c))
    return max(scored)[1] if scored else None


DEFAULT_SRC = _resolve_default_src()
DEFAULT_OUT = os.path.join(DATA_HOME, "memory-atlas.html")
# env overrides — path for the portable distribution (.pyz drops resources into a temp folder)
# d3 resolution: env → vendor/ next to the generator (a repo clone works out of the box) → data-home cache
def _resolve_d3():
    cands = [os.environ.get("ATLAS_D3"),
             os.path.join(os.path.dirname(os.path.realpath(__file__)), "vendor", "d3.v7.min.js"),
             os.path.join(DATA_HOME, "d3.v7.min.js")]
    for c in cands:
        if c and os.path.exists(c):
            return c
    return cands[-1]
D3_PATH = _resolve_d3()
EXCLUDE_DIRS = {".git", ".stfolder", ".stversions", "archive", "_archive", "assets",
                ".obsidian", ".trash", "node_modules"}   # G7: foreign vaults (Obsidian etc.)
INDEX_FILES = {"MEMORY.md", "MEMORY-work.md", "FEEDBACK_INDEX.md"}
ZONES = {"light": [-0.55, 0.05], "work": [0.75, -0.15],
         "feedback": [-0.2, 0.6], "unindexed": [-0.85, 0.8],
         # multi-root companions of an indexed corpus (wiki/skills roots) — fixed
         # anchors in the free top corners so the layout stays put
         "wiki": [0.5, -0.7], "skills": [-0.65, -0.6]}

# Top-level folders that are zones in their own right — one per project the vault owner
# keeps. These are the OWNER'S names, so the tool ships none: drop an `.atlas-zones.json`
# in the vault root (or point $ATLAS_ZONES at one) to declare them:
#   {"folders": ["research", "journal"], "anchors": {"research": [-0.1, -0.75]}}
# Absent, every top-level folder still becomes a zone by the generic path below — the
# config only matters for a corpus that also uses index files (MEMORY.md & co).
FOLDER_ZONES = set()


def load_zone_config(src):
    """Read the vault's own zone declaration; missing or malformed = generic layout."""
    path = os.environ.get("ATLAS_ZONES") or os.path.join(src, ".atlas-zones.json")
    try:
        with open(path, encoding="utf-8") as fh:
            cfg = json.load(fh)
    except (OSError, ValueError):
        return
    FOLDER_ZONES.update(str(f) for f in cfg.get("folders", []))
    for name, xy in (cfg.get("anchors") or {}).items():
        if isinstance(xy, list) and len(xy) == 2:
            ZONES[str(name)] = [float(xy[0]), float(xy[1])]

def zone_anchors(nodes):
    """Zone anchors [-1..1]. Our own corpus = fixed ZONES; foreign = alphabetical circle.
    >8 zones — legend colors the first 8, the rest OTHER-grey (contract B22)."""
    zs = sorted({n["zone"] for n in nodes})
    if set(zs) <= set(ZONES):
        return ZONES
    step = 2 * math.pi / max(1, len(zs))
    return {z: [round(0.72 * math.cos(i * step - math.pi / 2), 3),
                round(0.72 * math.sin(i * step - math.pi / 2), 3)]
            for i, z in enumerate(zs)}


FM_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.S)
# [[target]] and [[target|alias]] — take target up to |
WIKILINK_RE = re.compile(r"\[\[([^\]|#\n]+?)(?:\|[^\]\n]*)?\]\]")
MDLINK_RE = re.compile(r"\]\(([^)#\s]+?\.md)\)")

# Wikilinks written as SYNTAX EXAMPLES inside code — ``[[wikilinks]]``, `[[<handle>]]`
# in convention notes that document the link syntax itself — are not real links.
# Blank code out before scanning so they don't register as dangling ghosts.
FENCE_RE = re.compile(r"(?ms)^[ \t]*(`{3,}|~{3,})[^\n]*\n.*?^[ \t]*\1[^\n]*$")
INLINE_CODE_RE = re.compile(r"`[^`\n]+`")


def strip_code_spans(text):
    return INLINE_CODE_RE.sub(" ", FENCE_RE.sub("\n", text))


def norm(key):
    k = key.strip().lower().replace("-", "_")
    return k[:-3] if k.endswith(".md") else k   # str.removesuffix needs 3.9; floor is 3.8


def parse_frontmatter(text):
    text = text.lstrip("﻿")
    m = FM_RE.match(text)
    fm = {"name": None, "title": "", "description": "", "type": "",
          "part_of": "", "tier": "", "session": "", "state": "", "tags": []}
    if not m:
        return fm, text
    block = m.group(1)
    # G2: keys at BOTH levels (^\s*) — our nested format AND top-level Obsidian/reference-vault
    # `title:` is the Obsidian/foreign-vault spelling of `name:` — without this a foreign
    # note falls back to its stem and the graph shows slugs ("реакція") instead of the
    # author's own label ("Реакція"). name wins when both are present.
    for pat, key in ((r"^\s*name:\s*(.+)$", "name"),
                     (r"^\s*title:\s*(.+)$", "title"),
                     (r"^description:\s*(.+)$", "description"),
                     (r"^\s*type:\s*(.+)$", "type"),
                     (r"^\s*part_of:\s*(.+)$", "part_of"),
                     (r"^\s*tier:\s*(.+)$", "tier"),
                     (r"^\s*state:\s*(.+)$", "state"),
                     (r"^\s*originSessionId:\s*(.+)$", "session")):
        mm = re.search(pat, block, re.M)
        if mm:
            fm[key] = mm.group(1).strip().strip("\"'")
    # tags: inline `[a,b]`/`a,b` OR a YAML list of `- item` lines (Obsidian); top-level too
    tm = re.search(r"^\s*tags:[^\S\n]*(.*)$", block, re.M)
    if tm:
        inline = tm.group(1).strip()
        if inline and inline not in ("[]", "|", ">"):
            fm["tags"] = [t.strip().strip("\"'[]") for t in inline.split(",")
                          if t.strip().strip("[] ")]
        else:   # value on following lines: `  - tag`
            lst = []
            for ln in block[tm.end():].splitlines():
                lm = re.match(r"^\s*-\s*(.+)$", ln)
                if lm:
                    lst.append(lm.group(1).strip().strip("\"'"))
                elif ln.strip() and re.match(r"^\S", ln):
                    break
            fm["tags"] = lst
    if not fm["name"] and fm["title"]:
        fm["name"] = fm["title"]
    return fm, text[m.end():]


def scan(src):
    files = []
    for root, dirs, names in os.walk(src):
        dirs[:] = [d for d in dirs if d not in EXCLUDE_DIRS]
        for n in names:
            if n.endswith(".md"):
                files.append(os.path.join(root, n))
    return sorted(files)


def index_members(src, index_file):
    """Stems of notes referenced by the index file."""
    path = os.path.join(src, index_file)
    if not os.path.exists(path):
        return set()
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    stems = {norm(os.path.basename(t)) for t in MDLINK_RE.findall(text)
             if not t.startswith("http")}
    stems |= {norm(t) for t in WIKILINK_RE.findall(text)}
    return stems


def build_graph(src, exclude_tags=(), exclude_types=()):
    """src: a single dir, or a list of (name, dir) roots. Root #1 = primary (index-based
    zones as before); every extra root (wiki, skills, …) becomes ONE zone named after it.
    [[links]] resolve same-root first, then globally — a cross-root hit kills a ghost.

    exclude_tags/exclude_types drop notes from the GRAPH while keeping them on disk —
    the foreign-vault equivalent of an Obsidian graph filter. A vault can carry a large
    reference appendix (a glossary import: one tag, thousands of atomic pages) that is
    inventory, not knowledge; rendered as nodes it outnumbers the real notes and drowns
    every grouping axis. Excluded stems are REMEMBERED: links pointing at them resolve to
    nothing instead of minting ghosts, otherwise hiding an appendix just converts N nodes
    into N ghost nodes and the screen is no cleaner."""
    primary_src = src[0][1] if isinstance(src, list) else src
    load_zone_config(primary_src)   # zone names belong to the vault, not to this file

    roots = [(os.path.basename(os.path.abspath(src).rstrip(os.sep)) or "root", src)] \
        if isinstance(src, str) else list(src)
    now = time.time()
    primary_name, primary_src = roots[0]
    light_idx = index_members(primary_src, "MEMORY.md")
    work_idx = index_members(primary_src, "MEMORY-work.md")
    # FEEDBACK_INDEX is also a recall surface: its membership is NOT unindexed
    # (otherwise 81 feedback notes poison the gap-audit input with a false "never-indexed")
    fb_idx = index_members(primary_src, "FEEDBACK_INDEX.md")
    # foreign vault (none of our indexes exist — Obsidian etc.): zone = top-level folder.
    # Without this, everything collapses into unindexed = one zone, and the cross-zone
    # detectors (the whole overlap layer, the value-prop for a foreign vault) go silently dead.
    foreign = not (light_idx or work_idx or fb_idx)

    nodes, lookup = [], {}
    root_lookup = {name: {} for name, _ in roots}   # same-root resolve wins over global
    bodies = {}
    ex_tags = {t.strip().lstrip("#").lower() for t in exclude_tags if t.strip()}
    ex_types = {t.strip().lower() for t in exclude_types if t.strip()}
    excluded_stems = set()          # hidden-but-known: suppresses ghosts, see docstring
    shelved = []                    # off-graph but still indexed (browse + search)
    for rname, rsrc in roots:
        for path in scan(rsrc):
            base = os.path.basename(path)
            if base in INDEX_FILES:
                continue
            rel = os.path.relpath(path, rsrc)
            stem = norm(base)
            if stem in bodies:
                # stem collision (a-b.md vs a_b.md, same stem in another root, or the
                # SKILL.md/README.md family) — qualify with the parent dir first (readable id),
                # fall back to ~N; otherwise two nodes share an id and edges silently merge
                parent = os.path.basename(os.path.dirname(rel))
                cand = norm(f"{parent}_{base}") if parent else stem
                if cand != stem and cand not in bodies:
                    stem = cand
                else:
                    print(f"warn: stem collision '{stem}' ({rname}:{rel}) — suffixed",
                          file=sys.stderr)
                    i = 2
                    while f"{stem}~{i}" in bodies:
                        i += 1
                    stem = f"{stem}~{i}"
            with open(path, encoding="utf-8", errors="replace") as f:
                text = f.read()
            fm, body = parse_frontmatter(text)
            if ex_tags or ex_types:
                ntags = {str(t).lstrip("#").lower() for t in fm["tags"]}
                if (ntags & ex_tags) or (fm["type"] or "").lower() in ex_types:
                    # SHELVED, not deleted: off the canvas, still in browse + search index.
                    # A reference appendix is looked up, not navigated — dropping it from the
                    # index too would cost the one thing its author uses it for.
                    st = os.stat(path)
                    shelved.append({
                        "id": stem, "label": fm["name"] or stem, "desc": fm["description"][:400],
                        "type": fm["type"] or "?", "path": rel, "root": rname,
                        "bytes": st.st_size, "mtime": int(st.st_mtime),
                        "age_days": round((now - st.st_mtime) / 86400, 1),
                        "tags": fm["tags"], "shelf": True,
                        # same shape as a graph node so to_browse_data needs no special case
                        "ghost": False, "light": False, "heavy": False,
                        "orphan": False, "conflict": "sync-conflict" in base,
                        "part_of": fm["part_of"], "tier": fm["tier"],
                        "session": fm["session"], "state": fm["state"], "zone": "",
                    })
                    bodies[stem] = body
                    excluded_stems.add(norm(base))
                    if fm["name"]:
                        excluded_stems.add(norm(fm["name"]))
                    continue
            st = os.stat(path)

            top = rel.split(os.sep)[0] if os.sep in rel else ""
            base_stem = norm(base)
            if rname != primary_name:
                zone = rname               # extra root = one zone (wiki, skills)
            elif foreign:
                zone = top or "notes"
            elif top in FOLDER_ZONES:
                zone = top
            elif base_stem in light_idx:
                zone = "light"
            elif base_stem in work_idx:
                zone = "work"
            elif base_stem in fb_idx:
                zone = "feedback"
            else:
                zone = "unindexed"

            # browse module: light/heavy are INDEPENDENT booleans (a note can be in both
            # indexes); zone collapses them, so we emit the flags separately.
            in_light = rname == primary_name and base_stem in light_idx
            in_heavy = rname == primary_name and base_stem in work_idx
            # FEEDBACK_INDEX is a recall surface: its membership suppresses orphan just
            # like light/work (otherwise 81 fb-notes become false orphans — twin of the "81 unindexed" bug)
            in_fb = rname == primary_name and base_stem in fb_idx
            node = {
                "id": stem,
                "label": fm["name"] or stem,
                "desc": fm["description"][:400],
                "type": fm["type"] or "?",
                "zone": zone,
                "path": rel,
                "root": rname,
                "bytes": st.st_size,
                "age_days": round((now - st.st_mtime) / 86400, 1),
                "mtime": int(st.st_mtime),
                "ghost": False,
                "light": in_light,
                "heavy": in_heavy,
                "orphan": (rname == primary_name and not foreign
                           and not in_light and not in_heavy and not in_fb and not top),
                "conflict": "sync-conflict" in base,
                # working tags: part_of (child) + tier + manual tags; session for the fire-hook
                "part_of": fm["part_of"],
                "tier": fm["tier"],
                "session": fm["session"],
                "state": fm["state"],           # G2: metadata.state (superseded/transition) → STATE layer
                "tags": fm["tags"],
            }
            nodes.append(node)
            bodies[stem] = body
            lookup.setdefault(base_stem, stem)
            root_lookup[rname].setdefault(base_stem, stem)
            if fm["name"]:
                lookup.setdefault(norm(fm["name"]), stem)
                root_lookup[rname].setdefault(norm(fm["name"]), stem)

    edges, seen = [], set()
    ghosts = {}
    # links to index files ([[MEMORY-work]], [x](MEMORY.md)) — not ghost debt:
    # indexes are excluded from nodes deliberately, "should be written" doesn't apply to them
    index_stems = {norm(f) for f in INDEX_FILES}

    def add_edge(a, b, kind):
        if a == b:
            return
        k = (a, b)
        if k in seen:
            return
        seen.add(k)
        edges.append({"source": a, "target": b, "kind": kind})

    for node in list(nodes):
        stem = node["id"]
        body = strip_code_spans(bodies[stem])  # code-span wikilinks aren't real links
        own = root_lookup.get(node.get("root"), {})
        targets = [(norm(t), "wiki") for t in WIKILINK_RE.findall(body)]
        targets += [(norm(os.path.basename(t)), "md")
                    for t in MDLINK_RE.findall(body)
                    if not t.startswith("http")]
        for tkey, kind in targets:
            if not tkey:   # literal [[]] / [x]() in docs ABOUT wikilinks → empty stem, not a link
                continue
            hit = own.get(tkey) or lookup.get(tkey)
            if hit:
                add_edge(stem, hit, kind)
            else:
                if tkey in index_stems or tkey in excluded_stems:
                    continue
                if tkey not in ghosts:
                    ghosts[tkey] = {
                        "id": tkey, "label": tkey, "desc": "",
                        "type": "ghost", "zone": node["zone"], "path": "",
                        "bytes": 0, "age_days": 0, "ghost": True,
                        "light": False, "heavy": False, "orphan": False, "conflict": False,
                    }
                add_edge(stem, tkey, kind)
    nodes.extend(ghosts.values())

    # membership edges (карта1 — taxonomy skeleton): node.part_of → parent.
    # part_of names a parent note in frontmatter; resolve it like a wikilink target.
    # Distinct kind "part_of" so the client can lay out a CLEAN hierarchy (dendro/radial,
    # group=tier) separate from context edges (semantic/tag/temporal) — the two-level map:
    # membership ≠ context-degree, a child may have more context edges to a foreign parent
    # yet keep its taxonomic home. See EDITOR-ROADMAP #8.
    for node in nodes:
        po = (node.get("part_of") or "").strip()
        if not po:
            continue
        own = root_lookup.get(node.get("root"), {})
        pkey = norm(po)
        hit = own.get(pkey) or lookup.get(pkey)
        if hit:
            add_edge(node["id"], hit, "part_of")

    # heat ∈ [0,1]: 1 = fresh (age 0), 0 = oldest
    max_age = max((n["age_days"] for n in nodes if not n["ghost"]), default=1) or 1
    for n in nodes:
        n["heat"] = 0.0 if n["ghost"] else round(1 - n["age_days"] / max_age, 3)
    # shelved stay OUT of nodes on purpose: detectors, layout and clustering must not see
    # them (that is the whole point of shelving, and the cost — 58s -> 7s on a 2370-note
    # vault). They rejoin at browse/emit time, where being findable is all they need.
    return nodes, edges, bodies, shelved


# ------------------------------------------------- cross-zone detectors
# Port of graph-lab lib/detectors/* onto the atlas model: "graph" = zone, cross-edges
# connect zones. All pure functions (semantic takes ready-made vectors),
# session_co_occurrence is the only one with I/O (git log). Dedup against existing
# edges happens on the caller's side (_merge_cross).

def _by_zone(nodes):
    zs = {}
    for n in nodes:
        if not n.get("ghost"):
            zs.setdefault(n["zone"], []).append(n)
    return zs


def detect_shared_ref(nodes, edges):
    """Nodes from DIFFERENT zones reference the same ghost → an edge between them.
    Hubs (a ghost with >6 referrers) are skipped — quadratic noise, not signal."""
    ghost_ids = {n["id"] for n in nodes if n.get("ghost")}
    zone_of = {n["id"]: n["zone"] for n in nodes}
    refs = {}
    for e in edges:
        if e["target"] in ghost_ids and not e.get("cross"):
            refs.setdefault(e["target"], []).append(e["source"])
    out = []
    for ghost, srcs in sorted(refs.items()):
        if len(srcs) > 6:
            continue
        for a, b in itertools.combinations(sorted(set(srcs)), 2):
            if zone_of.get(a) != zone_of.get(b):
                out.append({"source": a, "target": b, "kind": "shared_ref", "ref": ghost})
    return out


def detect_tag_overlap(nodes, threshold=0.5, top_k=3):
    """Jaccard over working tags (tags + part_of + tier) between zones."""
    def tagset(n):
        s = {t.lower() for t in n.get("tags", []) if len(t) >= 2}
        if n.get("part_of"):
            s.add("part:" + n["part_of"].lower())
        if n.get("tier") not in (None, ""):
            s.add("tier:" + str(n["tier"]))
        return s
    tagged = [(n, tagset(n)) for n in nodes if not n.get("ghost")]
    tagged = [(n, s) for n, s in tagged if s]
    out = []
    for n, s in tagged:
        cands = []
        for m, t in tagged:
            if m["zone"] == n["zone"] or m["id"] <= n["id"]:
                continue
            u = s | t
            if len(u) < 2:
                continue
            j = len(s & t) / len(u)
            if j >= threshold:
                cands.append((j, m["id"]))
        for j, mid in sorted(cands, reverse=True)[:top_k]:
            out.append({"source": n["id"], "target": mid, "kind": "tag_overlap",
                        "score": round(j, 2)})
    return out


def detect_temporal(nodes, window_s=86400.0, top_k=2):
    """Co-modification: nearest-by-mtime neighbors in OTHER zones, window 24h.
    top_k caps the DEGREE (both endpoints), not just fan-out: the old per-source cap
    still let fresh hub notes collect a dash from everyone — the ~1250-edge rose flood.
    Greedy by delta: closest pairs win while both ends have quota."""
    zs = _by_zone(nodes)
    sorted_z = {z: sorted((n.get("mtime", 0), n["id"]) for n in ns if n.get("mtime"))
                for z, ns in zs.items()}
    cands, seen = [], set()
    for z, ns in sorted(zs.items()):
        for n in ns:
            mt = n.get("mtime")
            if not mt:
                continue
            for oz, arr in sorted_z.items():
                if oz == z or not arr:
                    continue
                i = bisect.bisect_left(arr, (mt,))
                for j in range(max(0, i - top_k), min(len(arr), i + top_k)):
                    d = abs(arr[j][0] - mt)
                    if d <= window_s:
                        key = tuple(sorted((n["id"], arr[j][1])))
                        if key not in seen:
                            seen.add(key)
                            cands.append((d, key[0], key[1]))
    degree, out = {}, []
    for d, a, b in sorted(cands):
        if degree.get(a, 0) >= top_k or degree.get(b, 0) >= top_k:
            continue
        degree[a] = degree.get(a, 0) + 1
        degree[b] = degree.get(b, 0) + 1
        out.append({"source": a, "target": b,
                    "kind": "temporal_proximity", "delta": round(d, 1)})
    return out


def detect_session(nodes, src, max_commits=1000):
    """git log co-touched: files from different zones in the same commit. Commits with >30 files
    are skipped (snapshot noise, not a session signal). No git → silent skip.
    --relative: node paths are relative to src, but a vault living in a SUBDIR of a repo
    (demo/, an Obsidian vault inside a bigger repo) gets repo-root-relative paths from
    git log — every path missed node_by_rel and the detector went silently dead."""
    node_by_rel = {n["path"]: n for n in nodes if n.get("path")}
    try:
        r = subprocess.run(
            ["git", "-C", src, "log", "--name-only", "--no-renames", "--relative",
             f"-{max_commits}", "--pretty=format:@%h"],
            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if r.returncode != 0:
        return []
    weights = {}
    files = []

    def flush():
        touched = [node_by_rel[f] for f in files if f in node_by_rel]
        if 2 <= len(touched) <= 30:
            for a, b in itertools.combinations(touched, 2):
                if a["zone"] != b["zone"]:
                    key = tuple(sorted((a["id"], b["id"])))
                    weights[key] = weights.get(key, 0) + 1
        files.clear()

    for line in r.stdout.splitlines():
        if line.startswith("@"):
            flush()
        elif line.strip():
            files.append(line.strip())
    flush()
    return [{"source": a, "target": b, "kind": "session_co_occurrence", "w": w}
            for (a, b), w in sorted(weights.items())]


def detect_structural(nodes, edges, max_motifs=5000):
    """chain-3 motifs a→b→c, center's signature is (type, in, out); matched across zones.
    Research-tier, opt-in: same shape ≠ same meaning (graph-lab contract P8)."""
    real = {n["id"]: n for n in nodes if not n.get("ghost")}
    outs, ins = {}, {}
    for e in edges:
        if e["source"] in real and e["target"] in real and not e.get("cross"):
            outs.setdefault(e["source"], []).append(e["target"])
            ins.setdefault(e["target"], []).append(e["source"])
    sig_map = {}
    count = 0
    for b in sorted(real):
        for a in sorted(ins.get(b, [])):
            for c in sorted(outs.get(b, [])):
                if a == c or count >= max_motifs:
                    continue
                count += 1
                nb = real[b]
                sig = (nb["type"], len(ins.get(b, [])), len(outs.get(b, [])))
                sig_map.setdefault(sig, []).append((a, b, c))
    out = []
    for sig, motifs in sorted(sig_map.items()):
        if len(motifs) < 2:
            continue
        for m1, m2 in itertools.combinations(motifs[:12], 2):
            if real[m1[1]]["zone"] == real[m2[1]]["zone"]:
                continue
            for pos in range(3):
                if m1[pos] != m2[pos]:
                    out.append({"source": m1[pos], "target": m2[pos],
                                "kind": "structural_homology", "position": pos})
    return out


# semantic: embeddings via any OpenAI-style /api/embed endpoint, sha-cache.
#
# Default measured, not assumed. On a personal non-English vault of ~2.4k notes, scored
# against hand-authored wikilinks as gold (hub links excluded), recall@10 was:
#   embeddinggemma   0.171     bge-m3   0.161     nomic-embed-text  0.112
#   char-3gram tf-idf 0.169  <- the null; nomic loses to it, the others only tie
# So: multilingual default, and no model is worth a heavy download here — the ranking
# is the bottleneck, not the encoder (see LEXICAL_FUSE below).
EMB_MODEL = os.environ.get("ATLAS_EMB_MODEL") or "embeddinggemma"
# Second model tried only if the first is not pulled on the host. Kept because it is the
# small/always-there one, NOT because it is good: it is the weakest of the three measured.
EMB_FALLBACK = os.environ.get("ATLAS_EMB_FALLBACK") or "nomic-embed-text"
EMB_CACHE = os.environ.get("ATLAS_EMB_CACHE") or os.path.join(DATA_HOME, "emb-cache.json")
# Any host, not just loopback: a laptop with no GPU can point this at a machine that has one.
OLLAMA = os.environ.get("ATLAS_OLLAMA") or "http://127.0.0.1:11434"
# Fuse a char-3gram lexical channel into the semantic detector. Same measurement:
# lexical alone 0.169, embeddings alone 0.171, reciprocal-rank fusion 0.179 @10 /
# 0.466 @50 — the two agree on only 58% of their top-10, so the union is worth more
# than either. Set ATLAS_LEXICAL_FUSE=0 for embeddings only.
LEXICAL_FUSE = os.environ.get("ATLAS_LEXICAL_FUSE", "1") not in ("0", "no", "false")


def _ollama_up(timeout=3):
    """Quick health-check, 3s cap (graph-lab lib/ollama.is_available contract)."""
    try:
        with urllib.request.urlopen(OLLAMA + "/api/version", timeout=timeout):
            return True
    except (urllib.error.URLError, OSError, TimeoutError):
        return False


def fetch_embeddings(texts_by_id, model=EMB_MODEL, cache_path=EMB_CACHE):
    """id → vec. Cache keyed on sha256(text). Ollama unavailable/stuck →
    PARTIAL result from the cache (whatever's there), not all-or-nothing; empty → None."""
    cache = {}
    if os.path.exists(cache_path):
        try:
            with open(cache_path, encoding="utf-8") as f:
                cache = json.load(f)
        except (json.JSONDecodeError, OSError):
            cache = {}
    keys = {nid: hashlib.sha256((model + "\0" + t).encode()).hexdigest()
            for nid, t in texts_by_id.items()}
    missing = [(nid, t) for nid, t in texts_by_id.items() if keys[nid] not in cache]

    def partial(reason):
        got = {nid: cache[k] for nid, k in keys.items() if k in cache}
        print(f"warn: Ollama {reason} — semantic from cache: {len(got)}/{len(keys)}, "
              f"{len(keys) - len(got)} notes without a vector", file=sys.stderr)
        return got or None

    if missing:
        if not _ollama_up():
            return partial("unavailable (health-check)")
        try:
            for i in range(0, len(missing), 32):
                batch = missing[i:i + 32]
                req = urllib.request.Request(
                    OLLAMA + "/api/embed",
                    json.dumps({"model": model, "input": [t for _, t in batch]}).encode(),
                    {"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=30) as resp:
                    embs = json.load(resp)["embeddings"]
                for (nid, _), v in zip(batch, embs):
                    cache[keys[nid]] = [round(x, 5) for x in v]
        except urllib.error.HTTPError as e:
            # 404 = that model is not pulled on this host. One retry with the fallback,
            # then give up: a second missing model means the host has no embedder.
            if e.code == 404 and model != EMB_FALLBACK:
                print(f"warn: model {model!r} not on {OLLAMA} — falling back to "
                      f"{EMB_FALLBACK!r} (weaker: measured recall@10 0.112 vs 0.171)",
                      file=sys.stderr)
                return fetch_embeddings(texts_by_id, EMB_FALLBACK, cache_path)
            return partial(f"failed on batch ({e})")
        except (urllib.error.URLError, OSError, KeyError, TimeoutError) as e:
            return partial(f"failed on batch ({e})")
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(cache, f)
    return {nid: cache[k] for nid, k in keys.items()}


def _lexical_neighbours(nodes, top_k=10, min_share=0.06):
    """id → [(share, id)] by idf-weighted char-3gram overlap.

    The measured null the embeddings only tie with, so it is worth having as its own
    channel. No numpy in the core, so this is an inverted index rather than an n²
    scan: rare 3-grams point at the few notes that share them, and only those get
    scored. Notes are short (title + description), which keeps the postings small.
    """
    docs = {}
    for n in nodes:
        if n.get("ghost"):
            continue
        text = (" ".join(str(n.get(f) or "") for f in ("label", "title", "desc"))).lower()
        if len(text) < 6:
            continue
        grams = collections.Counter(text[i:i + 3] for i in range(len(text) - 2))
        docs[n["id"]] = grams

    post = collections.defaultdict(list)
    for nid, grams in docs.items():
        for g in grams:
            post[g].append(nid)
    n_docs = max(1, len(docs))
    # A 3-gram in half the corpus carries nothing; skip it and keep the postings cheap.
    # The floor of 3 matters: on a small vault "half the corpus" is one or two notes, and
    # a bare ratio cutoff throws away exactly the grams two notes SHARE — the channel
    # then returns nothing at all, silently. Caught by test_lexical_channel_and_fusion.
    df_max = max(3, n_docs * 0.5)
    idf = {g: math.log(n_docs / float(len(ids))) for g, ids in post.items()
           if len(ids) <= df_max}

    norm = {}
    for nid, grams in docs.items():
        norm[nid] = math.sqrt(sum((k * idf[g]) ** 2
                                  for g, k in grams.items() if g in idf)) or 1.0

    out = {}
    for nid, grams in docs.items():
        acc = collections.defaultdict(float)
        for g, k in grams.items():
            w = idf.get(g)
            if w is None:
                continue
            wa = k * w
            for other in post[g]:
                if other != nid:
                    acc[other] += wa * docs[other].get(g, 0) * w
        scored = sorted(((v / (norm[nid] * norm[o]), o) for o, v in acc.items()),
                        reverse=True)[:top_k]
        out[nid] = [(s, o) for s, o in scored if s >= min_share]
    return out


def _rrf(*ranked_lists, k=60):
    """Reciprocal-rank fusion — the two channels' scores are not on one scale."""
    fused = collections.defaultdict(float)
    for lst in ranked_lists:
        for rank, item in enumerate(lst):
            fused[item] += 1.0 / (k + rank + 1)
    return sorted(fused, key=lambda i: -fused[i])


def _calibrate_threshold(normed, ids, quantile=0.999, floor=0.30, sample=400, seed=0):
    """Pick the cosine cutoff from THIS corpus under THIS model.

    Cosine scales are not comparable across embedders: on one vault 0.75 kept ~13% of
    pairs under nomic-embed-text and 0.04% under embeddinggemma, so a fixed default
    silently emptied the semantic layer the moment the model changed. Sample pairs,
    take a high quantile, and keep a floor so a degenerate corpus cannot open the gate
    all the way.
    """
    if len(ids) < 3:
        return floor
    rnd = random.Random(seed)
    pick = ids if len(ids) <= sample else rnd.sample(ids, sample)
    sims = []
    for i, a in enumerate(pick):
        va = normed[a]
        for b in pick[i + 1:]:
            sims.append(sum(x * y for x, y in zip(va, normed[b])))
    if not sims:
        return floor
    sims.sort()
    q = sims[min(len(sims) - 1, int(len(sims) * quantile))]
    return max(floor, round(q, 3))


def detect_semantic(nodes, vecs, threshold=None, top_k=3, within_zone=False):
    """cosine between zones ≥ threshold, top-k per source. vecs: id → vector.
    within_zone=True снимает зонный гейт — для плоского одногруппного вульта
    (глоссарий в одну папку), где без этого semantic даёт ноль рёбер.

    With LEXICAL_FUSE the char-3gram channel is fused in by reciprocal rank: measured
    on a personal vault of ~2.4k notes the two channels shared only 58% of their top-10, and fusing
    them beat either alone (recall@10 0.179 vs 0.171/0.169, median rank 76 → 62)."""
    def l2(v):
        s = sum(x * x for x in v) ** 0.5 or 1.0
        return [x / s for x in v]
    normed = {n["id"]: l2(vecs[n["id"]]) for n in nodes
              if not n.get("ghost") and n["id"] in vecs}
    zone_of = {n["id"]: n["zone"] for n in nodes}
    lex = _lexical_neighbours(nodes) if LEXICAL_FUSE else None
    ids_all = sorted(normed)
    if threshold is None:
        threshold = _calibrate_threshold(normed, ids_all)
        print(f"semantic: threshold calibrated to {threshold} for {EMB_MODEL}",
              file=sys.stderr)
    ids = sorted(normed)
    out, seen = [], set()
    for a in ids:
        va = normed[a]
        cands = []
        for b in ids:
            if b == a or (not within_zone and zone_of[a] == zone_of[b]):
                continue
            score = sum(x * y for x, y in zip(va, normed[b]))
            if score >= threshold:
                cands.append((score, b))
        sem = sorted(cands, reverse=True)
        by_id = {b: s for s, b in sem}
        if lex is not None:
            lx = [b for _, b in lex.get(a, [])
                  if b in normed and b != a and (within_zone or zone_of[a] != zone_of[b])]
            for b in lx:
                by_id.setdefault(b, 0.0)
            picked = _rrf([b for _, b in sem], lx)[:top_k]
        else:
            picked = [b for _, b in sem][:top_k]
        for b in picked:
            key = tuple(sorted((a, b)))
            if key in seen:
                continue
            seen.add(key)
            out.append({"source": a, "target": b, "kind": "semantic",
                        "score": round(by_id.get(b, 0.0), 2)})
    return out


def semantic_layout(vecs):
    """2D projection of embeddings — graph-lab's "fundamental principle #1":
    position encodes cosine-closeness, not edge strength. Their plan was UMAP (v0.6,
    never landed); here it's PCA power-iteration on L2-normalized vectors (stdlib,
    deterministic, ~2s on 324×768). id → (x, y) in [-1, 1]."""
    import math
    ids = sorted(vecs)
    if len(ids) < 3:
        return {}
    X = []
    for nid in ids:
        v = vecs[nid]
        s = math.sqrt(sum(x * x for x in v)) or 1.0
        X.append([x / s for x in v])
    n, dim = len(X), len(X[0])
    mean = [sum(row[j] for row in X) / n for j in range(dim)]
    X = [[row[j] - mean[j] for j in range(dim)] for row in X]

    comps, coords = [], []
    for c in range(2):
        # deterministic seed; deflate the previous component every iteration
        w = [math.sin((j + 1) * (c + 1) * 12.9898) for j in range(dim)]
        for _ in range(40):
            for pc in comps:
                d = sum(a * b for a, b in zip(w, pc))
                w = [a - d * b for a, b in zip(w, pc)]
            t = [sum(a * b for a, b in zip(row, w)) for row in X]      # X·w
            w2 = [0.0] * dim
            for ti, row in zip(t, X):                                   # Xᵀ·t
                for j, rj in enumerate(row):
                    w2[j] += ti * rj
            s = math.sqrt(sum(a * a for a in w2)) or 1.0
            w = [a / s for a in w2]
        comps.append(w)
        coords.append([sum(a * b for a, b in zip(row, w)) for row in X])
    out = {}
    for axis in range(2):
        mx = max(abs(v) for v in coords[axis]) or 1.0
        coords[axis] = [v / mx for v in coords[axis]]
    for i, nid in enumerate(ids):
        out[nid] = (round(coords[0][i], 4), round(coords[1][i], 4))
    return out


def quantize_vecs(vecs):
    """int8 quantization for client-side semantic search (the client re-normalizes)."""
    ids = sorted(vecs)
    q = []
    for nid in ids:
        v = vecs[nid]
        mx = max(abs(x) for x in v) or 1.0
        q.append([int(round(x / mx * 127)) for x in v])
    dim = len(vecs[ids[0]]) if ids else 0
    # url: the client-side search queries the SAME Ollama the build used —
    # the template used to hardcode 127.0.0.1:11434 and ignore ATLAS_OLLAMA
    return {"model": EMB_MODEL, "dim": dim, "ids": ids, "q": q, "url": OLLAMA}


def run_detectors(nodes, edges, bodies, src, args):
    """Run detectors in graph-lab's fixed order; dedup against base edges.
    src: single dir or (name, dir) roots list — session detector runs per root
    (git paths are root-relative; cross-root co-commits don't exist by construction)."""
    roots = [(None, src)] if isinstance(src, str) else list(src)
    seen = {tuple(sorted((e["source"], e["target"]))) for e in edges}
    ran, added = [], []

    def merge(name, cross):
        ran.append(name)
        for e in cross:
            key = tuple(sorted((e["source"], e["target"])))
            if key in seen:
                continue
            seen.add(key)
            e["cross"] = True
            added.append(e)

    merge("shared_ref", detect_shared_ref(nodes, edges))
    # embeddings are needed by the detector, --search-vecs, AND the semantic layout:
    # `--search-vecs --no-semantic-cross` used to silently lose ALL three
    if getattr(args, "semantic_cross", True) or getattr(args, "search_vecs", False):
        texts = {n["id"]: (n["label"] + "\n" + n["desc"] + "\n" +
                           bodies.get(n["id"], "")[:1500])
                 for n in nodes if not n.get("ghost")}
        vecs = fetch_embeddings(texts)
        if vecs:
            if getattr(args, "semantic_cross", True):
                merge("semantic", detect_semantic(nodes, vecs, args.semantic_threshold,
                                                  args.semantic_top_k,
                                                  getattr(args, "semantic_within_zone", False)))
            if getattr(args, "search_vecs", False):
                args._vecs_payload = quantize_vecs(vecs)
            # semantic layout: node.sx/sy for the "semantic" layout mode in the template
            byid = {n["id"]: n for n in nodes}
            for nid, (sx, sy) in semantic_layout(vecs).items():
                if nid in byid:
                    byid[nid]["sx"], byid[nid]["sy"] = sx, sy
    if getattr(args, "tag_cross", True):
        merge("tag_overlap", detect_tag_overlap(nodes, args.tag_threshold, args.tag_top_k))
    if getattr(args, "temporal_cross", True):
        merge("temporal_proximity", detect_temporal(nodes, args.temporal_window_s,
                                                    args.temporal_top_k))
    if getattr(args, "session_cross", True):
        for rname, rsrc in roots:
            sub = nodes if rname is None else \
                [n for n in nodes if n.get("root") == rname or n.get("ghost")]
            merge("session_co_occurrence",
                  detect_session(sub, rsrc, args.session_max_commits))
    if getattr(args, "structural_cross", False):
        merge("structural_homology", detect_structural(nodes, edges,
                                                       args.structural_max_motifs))
    return ran, added


def to_browse_data(nodes, edges, bodies, now):
    """Data shape for the pre-rebrand memory-map browse (terminal module).
    Derived from the atlas graph → same ids, so the graph⟷browse fuse connectors
    match nodes by id. ghost → type 'missing' (dangling in browse's terms)."""
    byid = {n["id"]: n for n in nodes}
    outc = {n["id"]: 0 for n in nodes}
    degc = {n["id"]: 0 for n in nodes}
    for e in edges:
        outc[e["source"]] += 1
        degc[e["source"]] += 1
        degc[e["target"]] += 1
    bnodes = []
    for n in nodes:
        if n["ghost"]:
            bnodes.append({
                "id": n["id"], "file": n["label"] + ".md (missing)", "name": n["label"],
                "type": "missing", "type_inferred": False,
                "desc": "dangling [[wikilink]] — target file missing",
                "light": False, "heavy": False, "orphan": False,
                "conflict": False, "index": False, "size": 0, "mtime": 0,
                "age_days": 0, "out": outc[n["id"]], "deg": degc[n["id"]],
            })
        else:
            bnodes.append({
                "id": n["id"], "file": n["path"], "name": n["label"],
                "type": n["type"], "type_inferred": False, "desc": n["desc"],
                "light": n["light"], "heavy": n["heavy"], "orphan": n["orphan"],
                "conflict": n["conflict"], "index": False,
                "size": n["bytes"], "mtime": n["mtime"], "age_days": n["age_days"],
                "out": outc[n["id"]], "deg": degc[n["id"]],
            })
    bedges = [{"s": e["source"], "t": e["target"], "missing": byid[e["target"]]["ghost"]}
              for e in edges]
    stats = {
        "total": sum(1 for n in bnodes if n["type"] != "missing"),
        "light": sum(1 for n in bnodes if n["light"]),
        "heavy": sum(1 for n in bnodes if n["heavy"]),
        "orphan": sum(1 for n in bnodes if n["orphan"]),
        "dangling": sum(1 for n in bnodes if n["type"] == "missing"),
        "conflict": sum(1 for n in bnodes if n["conflict"]),
        "edges": len(bedges),
    }
    types = {}
    for n in bnodes:
        if n["type"] != "missing":
            types[n["type"]] = types.get(n["type"], 0) + 1
    return {"nodes": bnodes, "edges": bedges, "bodies": bodies,
            "stats": stats, "types": types, "generated": int(now)}


def validate_data(data):
    """--data contract check: a broken external-builder graph used to render a dead
    page (JS crash, no data-ready) with exit 0. Fail loudly at build time instead."""
    if not isinstance(data, dict) or not isinstance(data.get("nodes"), list):
        sys.exit("memory-atlas: --data: expected a JSON object with a nodes[] list "
                 "(see DATA CONTRACT in the generator docstring)")
    ids = set()
    for i, n in enumerate(data["nodes"]):
        if not isinstance(n, dict) or not n.get("id"):
            sys.exit(f"memory-atlas: --data: nodes[{i}] missing 'id'")
        if n["id"] in ids:
            sys.exit(f"memory-atlas: --data: duplicate node id '{n['id']}'")
        ids.add(n["id"])
    edges = data.get("edges", [])
    if not isinstance(edges, list):
        sys.exit("memory-atlas: --data: edges must be a list")
    for i, e in enumerate(edges):
        if not isinstance(e, dict):
            sys.exit(f"memory-atlas: --data: edges[{i}] is not an object")
        for end in ("source", "target"):
            if e.get(end) not in ids:
                sys.exit(f"memory-atlas: --data: edges[{i}].{end} = "
                         f"{e.get(end)!r} references no node")


def lang_token(lang):
    # the '__LANG__' slot in the template; uk must survive (never collapse into ru)
    return "'%s'" % (lang if lang in ("ru", "en", "uk") else "ru")


def render(data, out, d3js=None, tpl=None, lang="ru"):
    if d3js is None:
        if not os.path.exists(D3_PATH):
            sys.exit(f"memory-atlas: d3 cache missing: {D3_PATH}\n"
                     f"  curl -Lo '{D3_PATH}' https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js")
        with open(D3_PATH, encoding="utf-8") as f:
            d3js = f.read()
    if tpl is None:
        tpl_path = os.environ.get("ATLAS_TEMPLATE") or \
            os.path.join(os.path.dirname(os.path.realpath(__file__)),
                         "memory-atlas.template.html")
        with open(tpl_path, encoding="utf-8") as f:
            tpl = f.read()
        # G5 handshake: generator and template are deployed as a symlink PAIR across
        # hosts — one going stale is silent garbage. Warn, don't fail (output still renders).
        if f'name="atlas-tpl" content="{VERSION}"' not in tpl:
            m = re.search(r'name="atlas-tpl" content="([^"]*)"', tpl)
            print(f"warn: template version {'skew: ' + m.group(1) if m else 'marker missing'}"
                  f" vs generator {VERSION} — stale symlink pair?", file=sys.stderr)
    # </script> inside desc would break the inline script — escape the slash
    payload = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    html = tpl.replace("/*__D3__*/", d3js).replace("\"__DATA__\"", payload) \
              .replace("'__LANG__'", lang_token(lang))
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write(html)
    return html


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"memory-atlas {VERSION}")
    ap.add_argument("--src", action="append", metavar="[NAME=]DIR",
                    help="vault root; repeatable — first root = primary (index zones), "
                         "extras become one zone each (default name = dir basename)")
    ap.add_argument("--out", default=DEFAULT_OUT)
    ap.add_argument("--data", help="ready-made graph JSON (file or '-' = stdin) instead of scanning memory")
    ap.add_argument("--dump-data", metavar="FILE",
                    help="write DATA JSON (file or '-' = stdout) instead of rendering — "
                         "source end of an external pipeline (provenance feed etc.)")
    ap.add_argument("--demo", action="store_true",
                    help="built-in demo vault: 2 clusters + hidden ghost bridge (shared_ref)")
    ap.add_argument("--no-open", action="store_true")
    ap.add_argument("--lang", choices=["ru", "en", "uk"], default=None,
                    help="starting UI language; without the flag — by system locale "
                         "(ru → ru, uk → uk, otherwise en); the toggle in the bar persists across rebuilds")
    ap.add_argument("--self-test", action="store_true")
    # cross-zone detectors (flag names = graph-lab CLI, including their asymmetry:
    # five --no-X-cross default-on, structural opt-in)
    ap.add_argument("--no-semantic-cross", dest="semantic_cross", action="store_false")
    # default None = calibrate from this corpus and model (see _calibrate_threshold).
    # A fixed cosine is model-specific: 0.75 kept ~13% of pairs on nomic-embed-text and
    # 0.04% on embeddinggemma — swapping the model silently emptied the semantic layer.
    ap.add_argument("--semantic-threshold", type=float, default=None)
    ap.add_argument("--semantic-top-k", type=int, default=3)
    ap.add_argument("--semantic-within-zone", action="store_true",
                    help="снять зонный гейт semantic — рёбра внутри одной группы "
                         "(для плоского одногруппного вульта: глоссарий в одну папку)")
    ap.add_argument("--no-tag-cross", dest="tag_cross", action="store_false")
    ap.add_argument("--tag-threshold", type=float, default=0.5)
    ap.add_argument("--tag-top-k", type=int, default=3)
    ap.add_argument("--no-temporal-cross", dest="temporal_cross", action="store_false")
    ap.add_argument("--temporal-window-s", type=float, default=86400.0)
    ap.add_argument("--temporal-top-k", type=int, default=2)   # was 5: ~1250 rose-dash edges drowned the real vault (user kill-call 07-09)
    ap.add_argument("--no-session-cross", dest="session_cross", action="store_false")
    ap.add_argument("--session-max-commits", type=int, default=1000)
    ap.add_argument("--structural-cross", action="store_true")
    ap.add_argument("--structural-max-motifs", type=int, default=5000)
    ap.add_argument("--exclude-tag", action="append", default=[], metavar="TAG",
                    help="не рисовать ноты с этим тегом (повторяемо); ссылки на них не станут ghost. "
                         "Для вульта со справочным приложением: --exclude-tag термін")
    ap.add_argument("--exclude-type", action="append", default=[], metavar="TYPE",
                    help="не рисовать ноты с этим frontmatter type (повторяемо), напр. --exclude-type source")
    ap.add_argument("--no-detectors", action="store_true", help="wikilink graph only")
    ap.add_argument("--fast-regen", action="store_true",
                    help="semantic+wiki only: skip O(n^2) tag/temporal and git-session detectors "
                         "(auto-sync on large vaults; the emb-cache keeps semantic fast)")
    ap.add_argument("--search-vecs", action="store_true",
                    help="int8 embeddings in DATA (client-side semantic search)")
    args = ap.parse_args()

    if args.self_test:
        run_self_test()
        return

    if args.lang is None:
        # locale-auto: ru/uk environment starts on ru, everything else on en;
        # the choice in the UI toggle persists and overrides this default from the second run on
        env_lang = (os.environ.get("LC_ALL") or os.environ.get("LANG") or
                    (locale.getlocale()[0] or ""))
        # uk locale starts in UK, not RU (a Ukrainian user must never be defaulted into Russian)
        low = env_lang.lower()
        args.lang = "ru" if low.startswith("ru") else "uk" if low.startswith("uk") else "en"

    if args.demo:
        args.src = [os.environ.get("ATLAS_DEMO") or
                    os.path.join(os.path.dirname(os.path.realpath(__file__)), "demo")]
        if args.out == DEFAULT_OUT:
            args.out = os.path.abspath("atlas-demo.html")
        # bundled demo has no meaningful edit-timeline (zip extraction flattens
        # mtimes to one instant → co-mod noise). Same for git: a repo-clone demo
        # sees OUR packaging commits (12+ files each) as fake "sessions" — 59 noise
        # edges — while the pyz demo (no git) sees none. Kill both so the demo shows
        # only the honest bridges: shared_ref (ghost) + tag_overlap.
        args.temporal_cross = False
        args.session_cross = False

    if args.fast_regen:
        # auto-sync path on large vaults: tag/temporal are O(n^2) and session shells out
        # to git — all three grow painful at ~2300 notes; semantic rides the sha emb-cache
        args.tag_cross = False
        args.temporal_cross = False
        args.session_cross = False
        args.structural_cross = False

    if not args.src and DEFAULT_SRC:
        args.src = [DEFAULT_SRC]
    if not args.data and not args.src:
        sys.exit("memory-atlas: no vault found — pass --src DIR (a folder of .md notes), "
                 "or try --demo. Autodetect looks at ~/.claude/projects/*/memory and $ATLAS_SRC.")
    # [NAME=]DIR → (name, abs_dir); duplicate names get ~2 (same discipline as stem collisions)
    roots, used = [], set()
    for s in (args.src or []):
        name, _, p = s.partition("=")
        if not p or os.path.isdir(s):        # no '=', or the whole string is a real dir
            name, p = "", s
        p = os.path.abspath(os.path.expanduser(p))
        if not os.path.isdir(p):
            sys.exit(f"memory-atlas: --src: not a directory: {p}")
        name = name or os.path.basename(p.rstrip(os.sep)) or "root"
        i, base = 2, name
        while name in used:
            name = f"{base}~{i}"
            i += 1
        used.add(name)
        roots.append((name, p))

    if args.data:
        raw = sys.stdin.read() if args.data == "-" else open(args.data, encoding="utf-8").read()
        try:
            data = json.loads(raw)
        except json.JSONDecodeError as e:
            sys.exit(f"memory-atlas: --data: invalid JSON ({e})")
        validate_data(data)
        data.setdefault("title", "atlas")
        data.setdefault("generated", time.strftime("%Y-%m-%d %H:%M"))
        data.setdefault("version", VERSION)
    else:
        nodes, edges, bodies, shelved = build_graph(roots, args.exclude_tag, args.exclude_type)
        if not nodes:
            print(f"warn: 0 nodes in {roots[0][1]} — pass --src /path/to/your/vault "
                  f"(a folder of .md notes)", file=sys.stderr)
        # browse only sees the wikilink graph (the terminal module predates detectors);
        # cross-edges go into the atlas graph only
        # shelved rejoin HERE and only here: browse is the lookup surface, the canvas is not
        browse = to_browse_data(nodes + shelved, edges, bodies, time.time())
        detectors, cross = ([], []) if args.no_detectors else \
            run_detectors(nodes, edges, bodies, roots, args)
        zones_payload = zone_anchors(nodes)
        # a foreign vault gets its own title = its own localStorage namespace (KEYP),
        # so config/views of the demo and the real vault don't leak into each other
        title = "memory-atlas" if zones_payload is ZONES else \
            (os.path.basename(roots[0][1]) or "atlas")
        data = {
            "title": title,
            "version": VERSION,
            "generated": time.strftime("%Y-%m-%d %H:%M"),
            "host": platform.node(),
            "src": roots[0][1],
            "roots": dict(roots),
            "zones": zones_payload,
            "heat": {"label": "freshness", "high": "fresh", "low": "stale"},
            "nodes": nodes,
            "edges": edges + cross,
            "detectors": detectors,
            # pre-rebrand terminal browse module: its own data shape
            # (deg/out/stats/types/bodies), derived from the graph → ids match for fuse
            "browse": browse,
            # off-canvas lookup layer: search must reach these, the graph must not draw them.
            # Metadata only — bodies already travel once, inside browse.
            "shelf": [{"id": n["id"], "label": n["label"], "type": n["type"],
                       "path": n["path"], "tags": n["tags"]} for n in shelved],
        }
        if getattr(args, "_vecs_payload", None):
            data["vecs"] = args._vecs_payload
        if cross:
            by_kind = {}
            for e in cross:
                by_kind[e["kind"]] = by_kind.get(e["kind"], 0) + 1
            print("cross: " + " ".join(f"{k}={v}" for k, v in sorted(by_kind.items())),
                  file=sys.stderr if args.dump_data == "-" else sys.stdout)

    ghosts = sum(1 for n in data["nodes"] if n.get("ghost"))
    if args.dump_data:
        payload = json.dumps(data, ensure_ascii=False)
        if args.dump_data == "-":
            sys.stdout.write(payload)          # stdout stays pure JSON for pipelines
        else:
            with open(args.dump_data, "w", encoding="utf-8") as f:
                f.write(payload)
        print(f"nodes={len(data['nodes'])} (ghosts={ghosts}) edges={len(data['edges'])}",
              file=sys.stderr)
        return
    render(data, args.out, lang=args.lang)
    print(f"nodes={len(data['nodes'])} (ghosts={ghosts}) edges={len(data['edges'])}")
    print(f"out: {args.out}")
    if not args.no_open:
        open_file(args.out)


def open_file(path):
    # cross-OS: `open` is macOS-only; an external user's target machine is unknown
    if sys.platform == "darwin":
        subprocess.run(["open", path], check=False)
    elif os.name == "nt":
        os.startfile(path)  # noqa: E1101  (Windows-only API)
    else:
        subprocess.run(["xdg-open", path], check=False)


# ---------------------------------------------------------------- self-test
def run_self_test():
    import tempfile
    import unittest

    class T(unittest.TestCase):
        def setUp(self):
            self.dir = tempfile.TemporaryDirectory()
            self.src = self.dir.name

        def tearDown(self):
            self.dir.cleanup()

        def w(self, rel, text):
            p = os.path.join(self.src, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w", encoding="utf-8") as f:
                f.write(text)

        def graph(self):
            nodes, edges, _, _ = build_graph(self.src)
            return {n["id"]: n for n in nodes}, edges

        def test_frontmatter(self):
            fm, body = parse_frontmatter(
                "---\nname: a-note\ndescription: \"hi: there\"\nmetadata:\n  type: project\n---\nbody")
            self.assertEqual(fm["name"], "a-note")
            self.assertEqual(fm["description"], "hi: there")
            self.assertEqual(fm["type"], "project")
            self.assertEqual(body, "body")

        def test_frontmatter_bom_and_missing(self):
            fm, _ = parse_frontmatter("﻿---\nname: x\n---\nb")
            self.assertEqual(fm["name"], "x")
            fm, body = parse_frontmatter("no fm here")
            self.assertIsNone(fm["name"])
            self.assertEqual(body, "no fm here")

        def test_frontmatter_top_level_keys(self):
            # G2: top-level type/tags (Obsidian/reference-vault) — used to be lost (indented only)
            fm, _ = parse_frontmatter(
                "---\nname: n\ntype: reference\ntags: [alpha, beta]\nmetadata:\n  state: superseded\n---\nx")
            self.assertEqual(fm["type"], "reference")
            self.assertEqual(fm["tags"], ["alpha", "beta"])
            self.assertEqual(fm["state"], "superseded")

        def test_frontmatter_yaml_list_tags(self):
            # G2: Obsidian YAML tag list
            fm, _ = parse_frontmatter("---\nname: n\ntags:\n  - one\n  - two\n---\nx")
            self.assertEqual(fm["tags"], ["one", "two"])

        def test_foreign_vault_zones_by_folder(self):
            # foreign vault (none of our indexes exist): zone = top-level folder, not unindexed.
            # without this, cross-zone detectors (the whole overlap) go silently dead for Daniel.
            self.w("cooking/a.md", "---\nname: a\n---\n[[ghostx]]")
            self.w("chemistry/b.md", "---\nname: b\n---\n[[ghostx]]")
            self.w("top.md", "---\nname: t\n---\nx")
            by, _ = self.graph()
            self.assertEqual(by["a"]["zone"], "cooking")
            self.assertEqual(by["b"]["zone"], "chemistry")
            self.assertEqual(by["top"]["zone"], "notes")   # root-level fallback
            self.assertFalse(by["a"]["orphan"])            # foreign → orphan off

        def test_exclude_appendix_by_tag_without_minting_ghosts(self):
            # foreign vault with a reference appendix: a glossary import, one tag, many atomic
            # pages, all linking back to one index note. Rendered as nodes they outnumber the
            # real notes. Hiding them must not convert N nodes into N ghosts.
            self.w("wiki/Хаб.md", "---\ntitle: Хаб\n---\n[[Термін А]] [[Концепт]]")
            self.w("wiki/Концепт.md", "---\ntitle: Концепт\ntags: [тема]\n---\nx")
            for t in ("А", "Б", "В"):
                self.w(f"wiki/Термін {t}.md", f"---\ntitle: Термін {t}\ntags: [термін]\n---\n[[Хаб]]")
            nodes, edges, bodies, shelved = build_graph(self.src, exclude_tags=["термін"])
            by = {n["id"]: n for n in nodes}
            self.assertNotIn(norm("Термін А.md"), by)          # appendix gone from the graph
            self.assertEqual([n for n in nodes if n["ghost"]], [])   # and left no ghost debt
            self.assertIn(norm("Концепт.md"), by)              # real notes untouched
            self.assertEqual(by[norm("Хаб.md")]["label"], "Хаб")     # title: honoured as label
            # …but shelved, not deleted: still reachable by lookup
            self.assertEqual(len(shelved), 3)
            self.assertIn(norm("Термін А.md"), bodies)         # body travels for search
            br = to_browse_data(nodes + shelved, edges, bodies, time.time())
            self.assertIn(norm("Термін А.md"), {n["id"] for n in br["nodes"]})
            self.assertEqual([n for n in br["nodes"] if n["type"] == "missing"], [])

        def test_exclude_by_type(self):
            self.w("wiki/a.md", "---\ntitle: a\ntype: concept\n---\n[[d]]")
            self.w("wiki/d.md", "---\ntitle: d\ntype: source\n---\nx")
            nodes, _, _, _ = build_graph(self.src, exclude_types=["source"])
            ids = {n["id"] for n in nodes}
            self.assertIn("a", ids)
            self.assertNotIn("d", ids)
            self.assertEqual([n for n in nodes if n["ghost"]], [])

        def test_code_span_wikilinks_not_ghosts(self):
            # convention notes document the [[wikilink]] syntax inside code — those must
            # NOT count as dangling ghosts (Daniel: 3 of 13 ghosts were exactly this).
            self.w("real.md", "---\nname: real\n---\ntarget")
            self.w("doc.md",
                   "---\nname: doc\n---\n"
                   "A real link to [[real]].\n"
                   "Inline example: `[[inline_ghost]]`.\n"
                   "```\n[[fenced_ghost]]\n```\n")
            by, edges = self.graph()
            self.assertIn("real", by)
            self.assertNotIn("inline_ghost", by)   # inline code → not a ghost
            self.assertNotIn("fenced_ghost", by)   # fenced code → not a ghost
            self.assertTrue(any(e["source"] == "doc" and e["target"] == "real"
                                for e in edges))

        def test_zone_anchors_foreign_circle(self):
            # our own corpus → fixed ZONES (same object); foreign → alphabetical circle
            our = [{"zone": z, "ghost": False} for z in ("light", "work")]
            self.assertIs(zone_anchors(our), ZONES)
            foreign = [{"zone": z, "ghost": False} for z in ("chemistry", "cooking")]
            an = zone_anchors(foreign)
            self.assertEqual(set(an), {"chemistry", "cooking"})
            for xy in an.values():
                self.assertTrue(all(-1 <= v <= 1 for v in xy))

        def test_multi_root_cross_resolve(self):
            # [[link]] into another root resolves to a real node — the ghost dies;
            # extra root = one zone named after it; node.root set on both sides
            self.w("MEMORY.md", "- [a](alpha.md)")
            self.w("alpha.md", "[[wiki_note]]")
            with tempfile.TemporaryDirectory() as d2:
                with open(os.path.join(d2, "wiki-note.md"), "w", encoding="utf-8") as f:
                    f.write("---\nname: wiki-note\n---\nsee [[alpha]]")
                nodes, edges, _, _ = build_graph([("memory", self.src), ("wiki", d2)])
            by = {n["id"]: n for n in nodes}
            self.assertIn("wiki_note", by)
            self.assertFalse(by["wiki_note"]["ghost"])       # resolved, not a ghost
            self.assertEqual(by["wiki_note"]["zone"], "wiki")
            self.assertEqual(by["wiki_note"]["root"], "wiki")
            self.assertEqual(by["alpha"]["root"], "memory")
            pairs = {(e["source"], e["target"]) for e in edges}
            self.assertIn(("alpha", "wiki_note"), pairs)     # memory → wiki
            self.assertIn(("wiki_note", "alpha"), pairs)     # wiki → memory

        def test_multi_root_same_root_wins_collision(self):
            # same stem in both roots: ids get suffixed, [[x]] resolves to the SAME-root file
            self.w("MEMORY.md", "- [n](note.md)")
            self.w("note.md", "primary body")
            self.w("uses.md", "[[note]]")
            with tempfile.TemporaryDirectory() as d2:
                with open(os.path.join(d2, "note.md"), "w", encoding="utf-8") as f:
                    f.write("wiki body")
                with open(os.path.join(d2, "wuses.md"), "w", encoding="utf-8") as f:
                    f.write("[[note]]")
                nodes, edges, _, _ = build_graph([("memory", self.src), ("wiki", d2)])
            by = {n["id"]: n for n in nodes}
            self.assertIn("note", by)
            self.assertIn("note~2", by)
            pairs = {(e["source"], e["target"]) for e in edges}
            self.assertIn(("uses", "note"), pairs)           # memory link → memory note
            self.assertIn(("wuses", "note~2"), pairs)        # wiki link → wiki twin

        def test_temporal_topk_cap(self):
            # per-node cap: top_k=2 → a node gets at most 2 temporal partners
            now = time.time()
            ns = [{"id": f"a{i}", "zone": "light", "ghost": False, "mtime": now + i}
                  for i in range(6)]
            ns += [{"id": "b", "zone": "work", "ghost": False, "mtime": now + 3}]
            out = detect_temporal(ns, window_s=86400.0, top_k=2)
            per_b = [e for e in out if "b" in (e["source"], e["target"])]
            self.assertLessEqual(len(per_b), 2)

        def test_fast_regen_skips_heavy_detectors(self):
            # --fast-regen: tag/temporal/session must not fire; wiki (+shared_ref/semantic) survive.
            # two zones with identical tags + mtimes would produce tag_overlap/temporal edges otherwise
            self.w("z1/a.md", "---\nname: a\ntags:\n  - x\n  - y\n---\n[[b]]")
            self.w("z2/b.md", "---\nname: b\ntags:\n  - x\n  - y\n---\ntext")
            r = subprocess.run(
                [sys.executable, os.path.realpath(__file__), "--src", self.src,
                 "--dump-data", "-", "--fast-regen"],
                capture_output=True, text=True, timeout=60,
                env={**os.environ, "ATLAS_OLLAMA": "http://127.0.0.1:1"})   # semantic degrades gracefully
            self.assertEqual(r.returncode, 0, r.stderr)
            kinds = {e.get("kind") for e in json.loads(r.stdout)["edges"]}
            self.assertLessEqual(kinds, {"wiki", "shared_ref", "semantic"},
                                 f"heavy detector leaked through --fast-regen: {kinds}")

        def test_lang_token_uk_survives(self):
            # a Ukrainian user must never be defaulted into Russian: uk is its own token
            self.assertEqual(lang_token("uk"), "'uk'")
            self.assertEqual(lang_token("en"), "'en'")
            self.assertEqual(lang_token("ru"), "'ru'")
            self.assertEqual(lang_token("xx"), "'ru'")   # unknown → canonical markup language

        def test_dump_data_pipeline(self):
            # --dump-data - prints pure DATA JSON on stdout (the pipeline source end)
            self.w("a.md", "[[b]]")
            self.w("b.md", "x")
            r = subprocess.run(
                [sys.executable, os.path.realpath(__file__), "--src", self.src,
                 "--dump-data", "-", "--no-detectors"],
                capture_output=True, text=True, timeout=60)
            self.assertEqual(r.returncode, 0, r.stderr)
            data = json.loads(r.stdout)          # stdout must be pure JSON
            validate_data(data)
            self.assertEqual({n["id"] for n in data["nodes"]}, {"a", "b"})
            self.assertIn("roots", data)

        def test_data_edge_styles_passthrough(self):
            # DATA CONTRACT v2.9: builder-declared edge kinds (provenance feed) render
            # via data — the payload carries them and the template merges into EDGE_STYLES
            data = {"title": "t", "zones": {}, "nodes": [
                {"id": "a", "label": "a", "desc": "", "type": "?", "zone": "z", "path": "",
                 "bytes": 0, "age_days": 0, "heat": 1, "ghost": False, "forgotten": 0.8}],
                "edges": [],
                "edge_styles": {"moved_from": {"c": "#c9903a", "a": 0.8, "arrow": True}},
                "node_metrics": ["forgotten"]}
            validate_data(data)   # v2.9 top-level keys must pass the contract check
            out = os.path.join(self.src, "es.html")
            tpl_path = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                    "memory-atlas.template.html")
            with open(tpl_path, encoding="utf-8") as f:
                tpl = f.read()
            html = render(data, out, d3js="/*d3*/", tpl=tpl)
            self.assertIn('"moved_from"', html)                    # declared kind in payload
            self.assertIn("Object.assign(EDGE_STYLES, DATA.edge_styles", tpl,
                          "template must merge builder-declared edge kinds")

        def test_node_metrics_colormode_hook(self):
            # DATA CONTRACT v2.9: node_metrics become colorMode options + a metric ramp
            tpl_path = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                    "memory-atlas.template.html")
            with open(tpl_path, encoding="utf-8") as f:
